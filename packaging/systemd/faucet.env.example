# /etc/qnero/faucet.env, mode 0600, owned by root, readable by qnero-faucet.

# The node's JSON-RPC endpoint. Loopback: nginx never proxies to this.
QNERO_FAUCET_NODE=http://127.0.0.1:9944

# The shielded spending key. Created on first start at mode 0600 if absent,
# with its note store beside it as <seed>.store.json. Back both up: the store
# is the only record of which notes are spent, and losing it costs a full
# rescan rather than the funds.
QNERO_FAUCET_SEED=/var/lib/qnero-faucet/spend.seed

# The transparent ML-DSA-87 seed behind the account the chain spec endows at
# genesis. Minted with `qnero-faucet keygen` before genesis was cut. There is
# no recovery: the address is in the genesis and cannot be changed without a
# new chain.
QNERO_FAUCET_TRANSPARENT_SEED=/var/lib/qnero-faucet/transparent.seed

# The address that seed must derive, copied from the chain spec's preset. The
# faucet refuses to start if the two disagree, which is what stops a wrong seed
# file becoming a faucet that serves, accepts claims and fails every shield at
# the transparent entry with BadSigner.
QNERO_FAUCET_EXPECT_ADDRESS=

QNERO_FAUCET_DB=/var/lib/qnero-faucet/claims.sqlite
QNERO_FAUCET_IP_HASH_KEY=/var/lib/qnero-faucet/ip-hash.key
QNERO_FAUCET_BIND=127.0.0.1:8080

# Amounts are pool quanta. One quantum is 10^10 planck, 0.01 QNR, so 1000
# quanta is 10 QNR.
QNERO_FAUCET_DRIP_QUANTA=1000
QNERO_FAUCET_COOLDOWN_HOURS=24
QNERO_FAUCET_IP_LIMIT=3
QNERO_FAUCET_IP_WINDOW_HOURS=24

# Below this, every claim is refused with `drained` rather than failing inside
# note selection after the queue has already taken it.
QNERO_FAUCET_MIN_BALANCE_QUANTA=5000
# Each top-up shields this much from the transparent account, up to
# QNERO_FAUCET_FUND_NOTES times, so the faucet holds several notes rather than
# one and a drip never waits on the change of the one before it.
QNERO_FAUCET_FUND_CHUNK_QUANTA=50000
QNERO_FAUCET_FUND_NOTES=4

# One prover, one drip at a time. Past this a claim is answered 503 with a
# Retry-After, which is the honest answer when the bottleneck is a ten-second
# proof.
QNERO_FAUCET_QUEUE_DEPTH=24

# Empty disables Turnstile, and /status reports which it is. A public faucet
# should have both of these set; a devnet run needs no Cloudflare account. The
# secret with no site key is refused at startup, because the server would
# demand a token the page has no widget to produce.
QNERO_FAUCET_TURNSTILE_SECRET=
QNERO_FAUCET_TURNSTILE_SITE_KEY=
